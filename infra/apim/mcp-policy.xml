<!-- REFERENCE ONLY: static checks do not execute APIM policy expressions or Entra validation. -->
<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="{{client-tenant-id}}" header-name="Authorization"
      failed-validation-httpcode="401" failed-validation-error-message="Unauthorized"
      output-token-variable-name="validatedClient">
      <client-application-ids><application-id>{{client-application-id}}</application-id></client-application-ids>
      <audiences><audience>{{client-audience}}</audience></audiences>
      <required-claims><claim name="roles" match="any"><value>Claims.Read</value></claim></required-claims>
    </validate-azure-ad-token>
    <rate-limit-by-key calls="12" renewal-period="60"
      counter-key='@(((Jwt)context.Variables["validatedClient"]).Claims.GetValueOrDefault("oid", "") + "|" + context.Api.Id)'
      retry-after-header-name="Retry-After" />
    <validate-content unspecified-content-type-action="ignore" max-size="16384" size-exceeded-action="prevent" />
    <set-variable name="requestAllowed" value='@{
      try {
        if (context.Request.Method != "POST") { return false; }
        if (!context.Request.Headers.GetValueOrDefault("Content-Type", "").StartsWith("application/json")) { return false; }
        var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
        if ((string)body["jsonrpc"] != "2.0") { return false; }
        var method = (string)body["method"];
        if (method == "initialize" || method == "notifications/initialized" || method == "ping" || method == "tools/list") { return true; }
        if (method != "tools/call") { return false; }
        var tool = (string)body["params"]["name"];
        return tool == "read_claim_evidence" || tool == "read_policy_clauses" || tool == "read_rule_findings";
      } catch { return false; }
    }' />
    <choose>
      <when condition='@(!(bool)context.Variables["requestAllowed"])'>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-body>{"status":"error","code":"rpc_scope_rejected"}</set-body>
        </return-response>
      </when>
    </choose>
    <set-header name="X-Claims-Grant" exists-action="delete" />
    <set-header name="X-Gateway-Principal" exists-action="delete" />
    <set-header name="X-Claim-Id" exists-action="delete" />
    <set-header name="X-Policy-Version" exists-action="delete" />
    <set-header name="Forwarded" exists-action="delete" />
    <set-header name="X-Forwarded-For" exists-action="delete" />
    <set-header name="X-Forwarded-Host" exists-action="delete" />
    <set-header name="X-Forwarded-Proto" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
    <!-- Separate backend audience and APIM service identity; never forward the client's token. -->
    <authentication-managed-identity resource="{{backend-audience}}" ignore-error="false" />
  </inbound>
  <backend><forward-request timeout="10" buffer-response="false" /></backend>
  <outbound>
    <base />
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
    <set-header name="X-Content-Type-Options" exists-action="override"><value>nosniff</value></set-header>
  </outbound>
  <on-error>
    <return-response>
      <set-status code='@(context.Response.StatusCode == 401 ? 401 : context.Response.StatusCode == 429 ? 429 : context.Response.StatusCode == 413 ? 413 : 500)' reason="Request rejected" />
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
      <set-body>{"status":"error","code":"gateway_rejected"}</set-body>
    </return-response>
  </on-error>
</policies>
